From e0b2890979bafa73cbb5e6bae49f71ca34c6d27a Mon Sep 17 00:00:00 2001
From: unk8s <unk8s@localhost>
Date: Tue, 17 Nov 2026 14:20:00 +0100
Subject: [PATCH] wasm: resolve the undefined symbols the unk8s config exposes

An undefined kernel symbol becomes a wasm import that the host stubs
with a trap, so every unresolved reference is a latent crash. The unk8s
config exposes two:

- CPUSETS=y on a uniprocessor kernel compiles the extern declaration of
  dl_rebuild_rd_accounting() into partition_sched_domains() (topology.c
  is built on UP in this tree), but the definition in cpuset.c sits
  inside #ifdef CONFIG_SMP. Define the UP no-op next to the existing UP
  rebuild_sched_domains_locked() stub.

- BPF_SYSCALL=y with MMU=y and 64BIT=y builds kernel/bpf/arena.o, whose
  arena_map_alloc() calls get_vm_area(). The wasm flat-memory vmalloc
  (vmalloc-flat.c) does not provide it. Return NULL: flat memory has no
  address ranges to reserve, and the only built caller, arena_map_alloc,
  turns NULL into a clean -ENOMEM.
---
 kernel/cgroup/cpuset.c | 4 ++++
 mm/vmalloc-flat.c      | 6 ++++++
 2 files changed, 10 insertions(+)

diff --git a/kernel/cgroup/cpuset.c b/kernel/cgroup/cpuset.c
index 86b592199..4d3744976 100644
--- a/kernel/cgroup/cpuset.c
+++ b/kernel/cgroup/cpuset.c
@@ -1078,6 +1078,10 @@ void rebuild_sched_domains_locked(void)
 void rebuild_sched_domains_locked(void)
 {
 }
+
+void dl_rebuild_rd_accounting(void)
+{
+}
 #endif /* CONFIG_SMP */
 
 static void rebuild_sched_domains_cpuslocked(void)
diff --git a/mm/vmalloc-flat.c b/mm/vmalloc-flat.c
index 9602f9b21..720c9cfbd 100644
--- a/mm/vmalloc-flat.c
+++ b/mm/vmalloc-flat.c
@@ -251,6 +251,12 @@ void free_vm_area(struct vm_struct *area)
 }
 EXPORT_SYMBOL_GPL(free_vm_area);
 
+struct vm_struct *get_vm_area(unsigned long size, unsigned long flags)
+{
+	return NULL;
+}
+EXPORT_SYMBOL_GPL(get_vm_area);
+
 int remap_vmalloc_range_partial(struct vm_area_struct *vma, unsigned long uaddr,
 				void *kaddr, unsigned long pgoff,
 				unsigned long size)
